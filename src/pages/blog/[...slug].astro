---
import { type CollectionEntry, getEntry, render } from "astro:content";
import { getPublishedPosts } from "../../utils/posts";
import { getProjectPosts, postYear } from "../../utils/projects";
import { projectTone } from "../../utils/tones";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const project = post.data.project && (await getEntry(post.data.project));
const series = project && {
  id: project.id,
  title: project.data.title,
  tone: projectTone(project.data.order),
  posts: (await getProjectPosts(project.id)).map((sibling) => ({
    id: sibling.id,
    year: postYear(sibling),
    current: sibling.id === post.id,
  })),
};
---

<BlogPost {...post.data} series={series || undefined}>
  <Content />
</BlogPost>
