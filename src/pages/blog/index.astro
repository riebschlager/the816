---
import { Image } from "astro:assets";
import { getPublishedPosts } from "../../utils/posts";
import FormattedDate from "../../components/FormattedDate.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Writing by Chris Riebschlager about creative technology, interactive experiences, and the work behind them."
>
  <div class="container">
    <header>
      <p class="eyebrow">Writing</p>
      <h1 class="display">Blog</h1>
    </header>
    <ul class="posts">
      {
        posts.map((post, i) => (
          <li class:list={[i % 2 ? "pink" : "cyan"]}>
            <a href={`/blog/${post.id}/`}>
              <div class="thumb">
                {post.data.heroImage ? (
                  <Image
                    width={720}
                    height={450}
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt ?? ""}
                    loading={i < 3 ? "eager" : "lazy"}
                  />
                ) : (
                  <span class="placeholder">{post.data.heroImageAlt}</span>
                )}
              </div>
              <span class="date">
                <FormattedDate date={post.data.pubDate} />
              </span>
              <span class="title">{post.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .eyebrow {
    color: var(--neon-cyan);
  }
  h1 {
    margin-top: var(--space-4);
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--space-7) var(--space-6);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }
  .cyan {
    --tone: var(--neon-cyan);
    --tone-glow: var(--glow-cyan);
  }
  .pink {
    --tone: var(--neon-pink);
    --tone-glow: var(--glow-pink);
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: inherit;
    text-decoration: none;
  }
  .thumb {
    aspect-ratio: 16 / 10;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-5);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
    text-align: center;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
    transition: color var(--dur-base);
  }
  a:hover .thumb {
    box-shadow: var(--tone-glow);
  }
  a:hover .thumb img {
    transform: scale(1.03);
  }
  a:hover .title {
    color: var(--tone);
  }
</style>
