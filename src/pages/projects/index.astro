---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { projectTone } from "../../utils/tones";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Projects"
  description="A selection of projects by Chris Riebschlager."
>
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Selected work</p>
      <h1 class="display">Projects</h1>
      <p class="lead">A few things taking shape. More to come.</p>
    </header>

    <ul class="project-list">
      {
        projects.map((project) => (
          <li>
            <a
              href={`/projects/${project.id}`}
              style={`--tone: var(--neon-${projectTone(project.data.order)}); --tone-glow: var(--text-glow-${projectTone(project.data.order)});`}
            >
              <span class="number">
                {String(project.data.order).padStart(2, "0")}
              </span>
              <span class="project-name">{project.data.title}</span>
              <Icon name="arrow-up-right" size={32} class="arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page-intro h1 {
    margin-top: var(--space-4);
  }
  .page-intro .lead {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
  }
  .project-list {
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border-default);
  }
  .project-list a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-default);
    color: var(--text-primary);
    text-decoration: none;
  }
  .number {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-base);
  }
  .project-name {
    font-family: var(--font-display);
    font-size: var(--text-display-md);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    transition:
      color var(--dur-base) var(--ease-out),
      text-shadow var(--dur-base) var(--ease-out);
  }
  .project-list :global(.arrow) {
    color: var(--text-faint);
    transition:
      transform var(--dur-base) var(--ease-snap),
      color var(--dur-base);
  }
  .project-list a:hover .number,
  .project-list a:hover .project-name,
  .project-list a:hover :global(.arrow) {
    color: var(--tone);
  }
  .project-list a:hover .project-name {
    text-shadow: var(--tone-glow);
  }
  .project-list a:hover :global(.arrow) {
    transform: translate(4px, -4px);
  }
  @media (max-width: 560px) {
    .project-list a {
      grid-template-columns: 32px minmax(0, 1fr) auto;
      gap: var(--space-4);
    }
  }
</style>
