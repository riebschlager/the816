---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import Tag from "../../components/Tag.astro";
import { getCollection } from "astro:content";
import { projectTone } from "../../utils/tones";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Projects"
  description="Selected work by Chris Riebschlager: a 46,000-square-foot immersive art world, live visuals for Thundergong, projection-mapped trees and interactive installations."
>
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Selected work</p>
      <h1 class="display">Projects</h1>
      <p class="lead">
        Immersive spaces, live visuals and interactive installations, from
        ground-up builds to weekend art shows with friends.
      </p>
    </header>

    <ul class="project-list">
      {
        projects.map((project, i) => {
          const tone = projectTone(project.data.order);
          const number = String(project.data.order).padStart(2, "0");
          return (
            <li>
              <a
                href={`/projects/${project.id}`}
                style={`--tone: var(--neon-${tone}); --tone-glow: var(--glow-${tone}); --tone-text-glow: var(--text-glow-${tone});`}
              >
                <div class="media-frame thumb">
                  {project.data.thumbnail ? (
                    <Image
                      src={project.data.thumbnail}
                      alt={project.data.thumbnailAlt ?? ""}
                      width={1280}
                      height={720}
                      loading={i < 2 ? "eager" : "lazy"}
                    />
                  ) : (
                    <span class="placeholder" aria-hidden="true">
                      {number}
                    </span>
                  )}
                </div>
                <div class="details">
                  <div class="heading">
                    <span class="number">{number}</span>
                    <Icon name="arrow-up-right" size={28} class="arrow" />
                  </div>
                  <h2 class="project-name">{project.data.title}</h2>
                  <p class="description">{project.data.description}</p>
                  {project.data.role && (
                    <p class="role">
                      <span class="role-label">My role</span>
                      {project.data.role}
                    </p>
                  )}
                  <span class="mediums">
                    {project.data.mediums.map((medium, m) => (
                      <Tag tone={m === 0 ? tone : "neutral"}>{medium}</Tag>
                    ))}
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page-intro h1 {
    margin-top: var(--space-4);
  }
  .page-intro .lead {
    max-width: 40ch;
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
  }
  .project-list {
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border-default);
  }
  .project-list a {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-7);
    align-items: center;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-default);
    color: var(--text-primary);
    text-decoration: none;
  }
  .thumb {
    aspect-ratio: 16 / 9;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .thumb :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    color: var(--tone);
    text-shadow: var(--tone-text-glow);
    background: radial-gradient(
      circle at 50% 120%,
      color-mix(in srgb, var(--tone) 28%, transparent),
      transparent 70%
    );
  }
  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .number {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--tone);
    font-variant-numeric: tabular-nums;
  }
  .project-name {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-display-md);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    transition:
      color var(--dur-base) var(--ease-out),
      text-shadow var(--dur-base) var(--ease-out);
  }
  .description,
  .role {
    line-height: 1.55;
  }
  .description {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .role {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--tone);
    color: var(--text-primary);
    text-wrap: pretty;
  }
  .role-label {
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .mediums {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .project-list :global(.arrow) {
    color: var(--text-faint);
    transition:
      transform var(--dur-base) var(--ease-snap),
      color var(--dur-base);
  }
  .project-list a:hover .thumb {
    box-shadow: var(--tone-glow);
  }
  .project-list a:hover .thumb :global(img) {
    transform: scale(1.03);
  }
  .project-list a:hover .project-name,
  .project-list a:hover :global(.arrow) {
    color: var(--tone);
  }
  .project-list a:hover .project-name {
    text-shadow: var(--tone-text-glow);
  }
  .project-list a:hover :global(.arrow) {
    transform: translate(4px, -4px);
  }
  @media (max-width: 900px) {
    .project-list a {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
