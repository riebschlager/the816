---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	return [
		{ slug: 'atlas9', title: 'Atlas9', number: '01' },
		{ slug: 'thundergong', title: 'Thundergong', number: '02' },
		{ slug: 'terra-luna', title: 'Terra Luna', number: '03' },
		{ slug: 'spectacle-society', title: 'Spectacle Society', number: '04' },
	].map(({ slug, ...project }) => ({ params: { slug }, props: { project } }));
}

const { project } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${project.title} | ${SITE_TITLE}`} description={`${project.title} project placeholder.`} />
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/projects">← All projects</a>
			<article>
				<p class="eyebrow">Project {project.number}</p>
				<h1>{project.title}</h1>
				<div class="status">
					<span aria-hidden="true"></span>
					In progress
				</div>
				<p class="placeholder">This project page is being assembled. Check back soon for the full story.</p>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.back {
		display: inline-block;
		margin-bottom: 4.5rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}
	article {
		max-width: 38rem;
	}
	.eyebrow {
		margin: 0 0 0.35rem;
		color: var(--accent-dark);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	h1 {
		margin-bottom: 1.25rem;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: fit-content;
		margin-bottom: 2.5rem;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		font-size: 0.8rem;
		font-weight: 700;
	}
	.status span {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent);
	}
	.placeholder {
		font-size: 1.2rem;
	}
</style>
