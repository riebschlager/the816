---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { type CollectionEntry, getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { slug: project.id }, props: project }));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${project.data.title} | ${SITE_TITLE}`} description={project.data.description} />
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/projects">← All projects</a>
			<article>
				<p class="eyebrow">Project {project.data.number}</p>
				<h1>{project.data.title}</h1>
				<div class="status">
					<span aria-hidden="true"></span>
					{project.data.status}
				</div>
				<div class="project-content">
					<Content />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.back {
		display: inline-block;
		margin-bottom: 4.5rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}
	article {
		max-width: 38rem;
	}
	.eyebrow {
		margin: 0 0 0.35rem;
		color: var(--accent-dark);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	h1 {
		margin-bottom: 1.25rem;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: fit-content;
		margin-bottom: 2.5rem;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface-raised);
		color: var(--text);
		font-size: 0.8rem;
		font-weight: 700;
	}
	.status span {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent);
	}
	.project-content {
		font-size: 1.2rem;
	}
	.project-content :global(.video-embed) {
		position: relative;
		width: 100%;
		margin: 2.5em 0;
		padding-bottom: 56.25%;
		overflow: hidden;
		border-radius: 8px;
		background: #000;
	}
	.project-content :global(.video-embed iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
