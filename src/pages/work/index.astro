---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout title="Work - the816">
  <Navigation />

  <main class="pt-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <h1 class="text-4xl md:text-5xl font-bold mb-12">Selected Work</h1>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project) => (
          <a
            href={`/work/${project.slug}`}
            class="group block overflow-hidden rounded-lg bg-gray-100 hover:shadow-lg transition-shadow"
          >
            <div class="aspect-video bg-gray-200 flex items-center justify-center">
              <img
                src={project.data.featured_image}
                alt={project.data.title}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-6">
              <h2 class="text-2xl font-bold mb-2 group-hover:text-gray-600 transition-colors">
                {project.data.title}
              </h2>
              <div class="text-sm text-gray-600 mb-3">
                {project.data.client} • {project.data.year}
              </div>
              <div class="text-sm text-gray-500">{project.data.role}</div>
              <div class="mt-3 flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <span class="text-xs px-2 py-1 bg-gray-200 rounded">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
