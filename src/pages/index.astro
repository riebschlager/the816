---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import ChrisAtThundergong from "../assets/chris-at-thundergong.jpg";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <h1>Hello, I'm Chris.</h1>
  <div class="intro">
    <figure class="portrait">
      <Image src={ChrisAtThundergong} alt="Chris at Thundergong" />
    </figure>
    <div class="copy">
      <p>
        I lead Creative Technology at <a
          href="https://dimin.com"
          target="_blank"
          rel="noopener noreferrer">Dimensional Innovations</a
        >, where my teams build interactive installations and immersive
        experiences for stadiums, museums, and entertainment venues. Twenty-plus
        years in, my work has run the gamut from web applications to venue-scale
        projects like <a href="/projects/atlas9">Atlas9</a>. The through-line
        has always been the same: knowing what an experience should feel like,
        and building until it does.
      </p>
    </div>
  </div>
  <p>
    I came up through creative coding (TouchDesigner, Processing,
    openFrameworks) and taught interactive installation and interaction design
    at the collegiate level. These days most of my energy goes into building
    teams of artists and technologists, and making sure the people doing the
    work have what they need to do it well. <strong
      >I learned from generous mentors. I try to be one.</strong
    >
  </p>
</BaseLayout>

<style>
  .intro {
    display: flow-root;
  }

  .portrait {
    float: left;
    width: min(39%, 253px);
    margin: 0.15rem 2rem 1rem 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.4rem;
    background: var(--surface);
    box-shadow: var(--box-shadow);
  }

  .portrait img {
    display: block;
    width: 100%;
    border-radius: 6px;
  }

  .copy p {
    margin-top: 0;
  }

  strong {
    color: var(--accent-dark);
  }

  @media (max-width: 560px) {
    .portrait {
      width: 44%;
      margin-right: 1.25rem;
    }
  }
</style>
