---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import ChrisAtThundergong from "../assets/chris-at-thundergong.jpg";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="container">
    <section class="hero">
      <div class="intro">
        <span class="eyebrow">Creative technologist · Kansas City</span>
        <h1 class="display">Hello, I'm Chris.</h1>
        <p class="lead">
          I lead Creative Technology at <a
            href="https://dimin.com"
            target="_blank"
            rel="noopener noreferrer">Dimensional Innovations</a
          >, where my teams build interactive installations and immersive
          experiences for stadiums, museums, and entertainment venues.
        </p>
      </div>
      <div class="media-frame portrait">
        <Image
          src={ChrisAtThundergong}
          alt="Chris at Thundergong"
          widths={[400, 640, 960]}
          sizes="(max-width: 720px) 100vw, 520px"
          loading="eager"
        />
      </div>
    </section>

    <section class="more">
      <p>
        Twenty-plus years in, my work has run the gamut from web applications to
        venue-scale projects like <a href="/projects/atlas9">Atlas9</a>. The
        through-line has always been the same: knowing what an experience should
        feel like, and building until it does.
      </p>
      <p>
        I came up through creative coding (TouchDesigner, Processing,
        openFrameworks) and taught interactive installation and interaction
        design at the collegiate level. These days most of my energy goes into
        building teams of artists and technologists, and making sure the people
        doing the work have what they need to do it well. <strong
          >I learned from generous mentors. I try to be one.</strong
        >
      </p>
      <div class="actions">
        <Button href="/projects" iconRight="arrow-up-right">
          See the projects
        </Button>
        <Button href="/blog" variant="secondary" tone="cyan">
          Read the blog
        </Button>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-8);
    align-items: center;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .intro h1 {
    font-size: var(--text-display-xl);
  }
  .lead {
    margin: 0;
  }
  .portrait {
    aspect-ratio: 4 / 5;
  }
  .more {
    max-width: var(--measure);
    margin-top: var(--space-8);
    color: var(--text-secondary);
  }
  .more p {
    margin: 0 0 var(--space-4);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
