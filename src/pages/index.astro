---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="the816 - Chris Riebschlager">
  <Navigation />

  <main class="pt-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-6">
          Chris Riebschlager
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto">
          Interactive experiences, real-time graphics, and creative technology
        </p>

        <!-- Placeholder for HomeCanvas.jsx Three.js component -->
        <div class="mt-12 h-96 bg-gray-100 rounded-lg flex items-center justify-center">
          <p class="text-gray-400">Three.js Canvas Component (HomeCanvas.jsx) will go here</p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
