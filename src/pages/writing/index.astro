---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Writing - the816">
  <Navigation />

  <main class="pt-16 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <h1 class="text-4xl md:text-5xl font-bold mb-12">Writing</h1>

      <div class="space-y-12">
        {posts.map((post) => (
          <article class="border-b border-gray-200 pb-12 last:border-0">
            <a href={`/writing/${post.slug}`} class="group">
              <h2 class="text-3xl font-bold mb-3 group-hover:text-gray-600 transition-colors">
                {post.data.title}
              </h2>
              <time class="text-sm text-gray-500 mb-4 block">
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <p class="text-gray-700 mb-4">{post.data.excerpt}</p>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-xs px-2 py-1 bg-gray-100 rounded">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
