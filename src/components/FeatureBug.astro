---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

interface Props {
  href: string;
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  title: string;
  cta: string;
  tone?: "pink" | "cyan" | "lime" | "orange";
}

const { href, image, alt, eyebrow, title, cta, tone = "pink" } = Astro.props;
---

<a
  class="feature-bug"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  style={`--neon: var(--neon-${tone}); --glow: var(--glow-${tone});`}
>
  <div class="thumb">
    <Image src={image} {alt} widths={[200, 400]} sizes="200px" />
  </div>
  <div class="body">
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="display">{title}</h2>
    <p><slot /></p>
    <span class="cta">
      {cta}
      <Icon name="arrow-up-right" size={18} class="icon-right" />
    </span>
  </div>
</a>

<style>
  .feature-bug {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-6);
    align-items: center;
    max-width: var(--measure);
    padding: var(--space-5);
    color: var(--text-secondary);
    text-decoration: none;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .feature-bug:hover {
    color: var(--text-secondary);
    border-color: var(--neon);
    box-shadow: var(--glow);
  }
  .feature-bug:active {
    transform: scale(0.99);
  }
  .thumb {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background: var(--ink-1000);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .feature-bug:hover .thumb img {
    transform: scale(1.03);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .eyebrow {
    color: var(--neon);
  }
  .display {
    font-size: var(--text-display-md);
  }
  .body p {
    margin: 0;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--text-primary);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .feature-bug:hover .cta {
    color: var(--neon);
  }
  .cta :global(.icon-right) {
    transition: transform var(--dur-base) var(--ease-snap);
  }
  .feature-bug:hover .cta :global(.icon-right) {
    transform: translate(2px, -2px);
  }

  @media (max-width: 560px) {
    .feature-bug {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-bug,
    .thumb img,
    .cta :global(.icon-right) {
      transition: none;
    }
    .feature-bug:hover .thumb img {
      transform: none;
    }
  }
</style>
