---
// Lucide icons (https://lucide.dev), inlined so they inherit currentColor.
const ICONS = {
  "arrow-up-right": ["M7 7h10v10", "M7 17 17 7"],
  "arrow-left": ["m12 19-7-7 7-7", "M19 12H5"],
} as const;

interface Props {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {ICONS[name].map((d) => <path {d} />)}
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
