---
interface Props {
	variant?: 'article' | 'project';
}

const { variant = 'article' } = Astro.props;
---

<div class:list={['prose', variant]}>
	<slot />
</div>

<style>
	.prose {
		color: var(--text);
	}
	.article {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
	}
	.project {
		font-size: 1.2rem;
	}
	.prose :global(p) {
		margin-bottom: 2em;
	}
	.prose :global(figure) {
		margin: 2.5em 0;
	}
	.prose :global(figcaption) {
		margin-top: 0.5em;
		color: var(--text-muted);
		font-size: 0.85em;
		text-align: center;
	}
	.prose :global(.video-embed) {
		position: relative;
		width: 100%;
		margin: 2.5em 0;
		padding-bottom: 56.25%;
		overflow: hidden;
		border-radius: 8px;
		background: #000;
	}
	.prose :global(.video-embed iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
