---
import { NAVIGATION, SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
---

<header>
  <div class="container inner">
    <a class="wordmark" href="/">{SITE_TITLE}</a>
    <nav aria-label="Main">
      {
        NAVIGATION.map(({ href, label }) => (
          <HeaderLink {href}>{label}</HeaderLink>
        ))
      }
    </nav>
    <SocialLinks placement="header" />
  </div>
</header>
<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--header-bg);
    border-bottom: 1px solid var(--border-subtle);
    -webkit-backdrop-filter: blur(var(--blur-header));
    backdrop-filter: blur(var(--blur-header));
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: var(--header-height);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: var(--tracking-wordmark);
    color: var(--text-primary);
    text-decoration: none;
  }
  .wordmark:hover {
    color: var(--neon-pink);
  }
  nav {
    display: flex;
    flex: 1;
    gap: var(--space-5);
  }
  @media (max-width: 480px) {
    .inner {
      gap: var(--space-4);
    }
    nav {
      gap: var(--space-4);
    }
  }
</style>
