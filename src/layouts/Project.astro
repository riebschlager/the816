---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/Button.astro";
import Prose from "../components/Prose.astro";
import Tag from "../components/Tag.astro";
import { projectTone } from "../utils/tones";

type Props = CollectionEntry<"projects">["data"];

const { title, description, order, mediums } = Astro.props;
const tone = projectTone(order);
---

<BaseLayout {title} {description} mainClass="project">
  <article class="container-prose">
    <Button href="/projects" variant="ghost" size="sm" icon="arrow-left">
      All projects
    </Button>
    <p class="eyebrow" style={`color: var(--neon-${tone})`}>
      Project {String(order).padStart(2, "0")}
    </p>
    <h1 class="display">{title}</h1>
    <ul class="mediums">
      {
        mediums.map((medium, i) => (
          <li>
            <Tag tone={i === 0 ? tone : "neutral"}>{medium}</Tag>
          </li>
        ))
      }
    </ul>
    <Prose><slot /></Prose>
  </article>
</BaseLayout>

<style>
  :global(main.project) {
    padding-top: var(--space-7);
  }
  .eyebrow {
    margin-top: var(--space-6);
  }
  h1 {
    margin-top: var(--space-3);
  }
  .mediums {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 var(--space-7);
    padding: 0;
    list-style: none;
  }
</style>
