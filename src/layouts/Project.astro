---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/Button.astro";
import Prose from "../components/Prose.astro";
import Tag from "../components/Tag.astro";
import ProjectTimeline from "../components/ProjectTimeline.astro";
import type { TimelineEntry } from "../utils/projects";
import { projectTone } from "../utils/tones";
import { creativeWorkSchema } from "../utils/schema";
import { getSocialImageURL } from "../utils/socialImage";

type Props = CollectionEntry<"projects">["data"] & {
  timeline?: TimelineEntry[];
};

const {
  title,
  description,
  order,
  mediums,
  thumbnail,
  thumbnailAlt,
  socialImage,
  socialImageAlt,
  timeline = [],
} = Astro.props;
const tone = projectTone(order);

const shareImage = socialImage ?? thumbnail;
const shareImageAlt = socialImage ? socialImageAlt : thumbnailAlt;
const schema = creativeWorkSchema({
  title,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: await getSocialImageURL(shareImage),
  mediums,
});
---

<BaseLayout
  {title}
  {description}
  image={shareImage}
  imageAlt={shareImageAlt}
  {schema}
  mainClass="project"
>
  <article class="container-prose">
    <Button href="/projects" variant="ghost" size="sm" icon="arrow-left">
      All projects
    </Button>
    <p class="eyebrow" style={`color: var(--neon-${tone})`}>
      Project {String(order).padStart(2, "0")}
    </p>
    <h1 class="display">{title}</h1>
    <ul class="mediums">
      {
        mediums.map((medium, i) => (
          <li>
            <Tag tone={i === 0 ? tone : "neutral"}>{medium}</Tag>
          </li>
        ))
      }
    </ul>
    <Prose><slot /></Prose>
    {timeline.length > 0 && <ProjectTimeline entries={timeline} {tone} />}
  </article>
</BaseLayout>

<style>
  :global(main.project) {
    padding-top: var(--space-7);
  }
  .eyebrow {
    margin-top: var(--space-6);
  }
  h1 {
    margin-top: var(--space-3);
  }
  .mediums {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 var(--space-7);
    padding: 0;
    list-style: none;
  }
</style>
