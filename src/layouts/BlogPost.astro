---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Button from "../components/Button.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Prose from "../components/Prose.astro";
import BaseLayout from "./BaseLayout.astro";
import type { NeonTone } from "../utils/tones";
import { blogPostingSchema } from "../utils/schema";
import { getSocialImageURL } from "../utils/socialImage";

type Props = CollectionEntry<"blog">["data"] & {
  series?: {
    id: string;
    title: string;
    tone: NeonTone;
    posts: { id: string; year: number; current: boolean }[];
  };
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  socialImage,
  socialImageAlt,
  series,
} = Astro.props;

const shareImage = socialImage ?? heroImage;
const shareImageAlt = socialImage ? socialImageAlt : heroImageAlt;
const tags = series ? [series.title] : [];
const schema = blogPostingSchema({
  title,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: await getSocialImageURL(shareImage),
  pubDate,
  updatedDate,
  tags,
});
---

<BaseLayout
  {title}
  {description}
  image={shareImage}
  imageAlt={shareImageAlt}
  type="article"
  publishedDate={pubDate}
  {updatedDate}
  {tags}
  {schema}
  mainClass="blog-post"
>
  <article>
    {
      heroImage && (
        <div class="container">
          <div class="media-frame hero">
            <Image
              width={1120}
              height={560}
              src={heroImage}
              alt={heroImageAlt ?? ""}
              loading="eager"
            />
          </div>
        </div>
      )
    }
    <div class="container-prose body">
      <Button href="/blog" variant="ghost" size="sm" icon="arrow-left">
        All posts
      </Button>
      <header>
        <p class="eyebrow date">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <span class="updated">
                · Updated <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </p>
        <h1 class="display">{title}</h1>
      </header>
      {
        series && (
          <nav
            class="series"
            aria-label={`${series.title} project`}
            style={`--tone: var(--neon-${series.tone});`}
          >
            <a class="series-project" href={`/projects/${series.id}`}>
              Part of the {series.title} project
            </a>
            {series.posts.length > 1 && (
              <ol>
                {series.posts.map((sibling) => (
                  <li>
                    {sibling.current ? (
                      <span aria-current="page">{sibling.year}</span>
                    ) : (
                      <a href={`/blog/${sibling.id}/`}>{sibling.year}</a>
                    )}
                  </li>
                ))}
              </ol>
            )}
          </nav>
        )
      }
      <hr />
      <Prose><slot /></Prose>
    </div>
  </article>
</BaseLayout>

<style>
  :global(main.blog-post) {
    padding-top: var(--space-7);
  }
  .hero {
    aspect-ratio: 2 / 1;
  }
  .body {
    margin-top: var(--space-7);
  }
  .date {
    margin-top: var(--space-5);
    color: var(--text-muted);
  }
  h1 {
    margin-top: var(--space-3);
    font-size: var(--text-display-md);
    line-height: 1.02;
    text-wrap: balance;
  }
  hr {
    margin: var(--space-6) 0;
  }
  .series {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--tone) 8%, transparent);
  }
  .series a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-base);
  }
  .series a:hover {
    color: var(--tone);
  }
  .series .series-project {
    color: var(--tone);
  }
  .series ol {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .series [aria-current] {
    color: var(--text-primary);
    font-weight: 700;
  }
</style>
