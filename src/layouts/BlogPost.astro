---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Button from "../components/Button.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Prose from "../components/Prose.astro";
import BaseLayout from "./BaseLayout.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt } =
  Astro.props;
---

<BaseLayout
  {title}
  {description}
  image={heroImage}
  type="article"
  publishedDate={pubDate}
  {updatedDate}
  mainClass="blog-post"
>
  <article>
    {
      heroImage && (
        <div class="container">
          <div class="media-frame hero">
            <Image
              width={1120}
              height={560}
              src={heroImage}
              alt={heroImageAlt ?? ""}
              loading="eager"
            />
          </div>
        </div>
      )
    }
    <div class="container-prose body">
      <Button href="/blog" variant="ghost" size="sm" icon="arrow-left">
        All posts
      </Button>
      <header>
        <p class="eyebrow date">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <span class="updated">
                · Updated <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </p>
        <h1 class="display">{title}</h1>
      </header>
      <hr />
      <Prose><slot /></Prose>
    </div>
  </article>
</BaseLayout>

<style>
  :global(main.blog-post) {
    padding-top: var(--space-7);
  }
  .hero {
    aspect-ratio: 2 / 1;
  }
  .body {
    margin-top: var(--space-7);
  }
  .date {
    margin-top: var(--space-5);
    color: var(--text-muted);
  }
  h1 {
    margin-top: var(--space-3);
    font-size: var(--text-display-md);
    line-height: 1.02;
    text-wrap: balance;
  }
  hr {
    margin: var(--space-6) 0;
  }
</style>
